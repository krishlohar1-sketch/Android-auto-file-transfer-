<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.autofiletransfer">

    <!-- Camera Access for Visual Handshake -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Automated Background Wi-Fi State Controls -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13+ Local Device Discovery (Crucial for avoiding location prompts) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" 
                     android:usesPermissionFlags="neverForLocation" />
    
    <!-- Legacy Android Support -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:label="Auto Flash Transfer"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        <!-- Main Activity goes here -->
    </application>

</manifest>
